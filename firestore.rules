
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      // Helper to safely access user's subscription tier from their profile.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionTier;
    }
    
    function isPro() {
      // A user is 'pro' if their profile's subscriptionTier is 'pro',
      // or if they are in the whitelist with the 'pro' role.
      return isSignedIn() && (getUserRole() == 'pro' ||
             (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email)) &&
              get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'pro'));
    }

    function isAdmin() {
      // An admin is explicitly defined in the whitelist collection by their email.
      return isSignedIn() && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'admin';
    }

    // --- Content Rules ---
    match /categories/{categoryId} {
      // Allow everyone to read all categories. UI will handle locking.
      allow read: if true;
      // Only admins can create, update, or delete categories.
      allow write: if isAdmin();
    }

    match /categories/{categoryId}/items/{itemId} {
      // Allow everyone to read all items. UI will handle locking.
      allow read: if true;
      // Only admins can write content items.
      allow write: if isAdmin();
    }

    // --- App Configuration Rules ---
    match /pricingPlans/{planId} {
        // Pricing plans are public to read.
        allow read: if true;
        // Only admins can manage pricing plans.
        allow write: if isAdmin();
    }
    
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- User Data Rules ---
    match /users/{userId} {
        // Users can read and write their own profile.
        // During activation, an anonymous user can create their own profile document.
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
    }
    
    match /users/{userId}/suggestions/{suggestionId} {
        // Users can manage their own suggestions.
        allow read, write: if isOwner(userId);
    }

    match /subscriptionRequests/{requestId} {
      // Anyone can create a subscription request.
      allow create: if true;
      // Only admins can read or manage requests.
      allow read, write: if isAdmin();
    }

    match /whitelist/{email} {
      // Allow signed-in users to read to enable client-side activation.
      // TODO: For improved security, this check should be moved to a Cloud Function
      // to avoid exposing the whitelist collection to authenticated clients.
      allow read: if isSignedIn();
      // Only admins can manage the whitelist.
      allow write: if isAdmin();
    }
  }
}
