
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'admin');
    }

    function isEditor() {
      return isSignedIn() && (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'editor');
    }

    function hasActiveSubscription() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.subscriptionTier == 'pro' &&
             (profile.subscriptionEndDate == null || profile.subscriptionEndDate > request.time);
    }

    function isPro() {
      return isSignedIn() && (isAdmin() || hasActiveSubscription());
    }

    // --- Content Rules ---
    match /categories/{categoryId} {
      // Allow everyone to read all categories. UI will handle locking.
      allow read: if true;
      // Only admins can create, update, or delete categories.
      allow write: if isAdmin();
    }

    match /categories/{categoryId}/items/{itemId} {
      // Allow everyone to read all items. UI will handle filtering based on status.
      allow read: if true;
      // An 'admin' can create/update/delete any item.
      // An 'editor' can only create items, and they must be in 'pending' status.
      allow create: if isAdmin() || (isEditor() && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // --- App Configuration Rules ---
    match /pricingPlans/{planId} {
        // Pricing plans are public to read.
        allow read: if true;
        // Only admins can manage pricing plans.
        allow write: if isAdmin();
    }
    
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- User Data Rules ---
    match /users/{userId} {
        // Users can read and write their own profile.
        allow read, write: if isOwner(userId);
        // A newly created user (during activation) can create their own profile.
        allow create: if request.auth.uid == userId;
    }
    
    match /users/{userId}/suggestions/{suggestionId} {
        // Users can manage their own suggestions.
        allow read, write: if isOwner(userId);
    }

    match /subscriptionRequests/{requestId} {
      // Anyone can create a subscription request.
      allow create: if true;
      // Only admins can read or manage requests.
      allow read, write: if isAdmin();
    }

    match /whitelist/{email} {
      allow read: if true;

      // CREATE: Only an existing admin can create any entry.
      allow create: if isAdmin();

      // UPDATE: An admin can update any entry, OR a pro user can claim their activation.
      allow update: if isAdmin() || 
                     (request.auth.uid != null && request.resource.data.activatedByUid == request.auth.uid && resource.data.activatedByUid == null);

      // DELETE: Only admins can delete.
      allow delete: if isAdmin();
    }
  }
}
